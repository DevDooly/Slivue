# 실제 값은 keystore.properties에 작성하고 Git에 커밋하지 않습니다.
storeFile=C:/secure/path/notification-edge-release.keystore
storePassword=change-me
keyAlias=notificationedge
keyPassword=change-me

# Play 업로드 키는 직접 배포 서명과 별개입니다. 아래 항목은 필요할 때만 주석을 해제하고
# 실제 keystore.properties(추적 제외) 또는 PLAY_UPLOAD_* 비밀 환경변수에 설정합니다.
# 기존 노출 legacy·회전 direct 인증서를 업로드 키로 재사용하면 준비 검사에서 거절합니다.
