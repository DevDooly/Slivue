<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission for floating Edge handle & panel -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Foreground Service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- Post notifications for service status -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Haptic feedback on edge gesture -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Auto start after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- 활성 미디어 세션의 앱이 PiP를 선언했는지 확인한다. 전체 패키지 조회 권한은 요청하지 않는다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NotificationEdgeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationEdge"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">
        
        <!-- 런처 메인 엔트리 포인트 (완전 투명 트램펄린) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NotificationEdge.TranslucentLauncher"
            android:taskAffinity="${applicationId}.launcher"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 설정 화면 전용 액티비티 -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.NotificationEdge"
            android:taskAffinity="${applicationId}.settings"
            android:launchMode="singleTask"
            android:noHistory="false"
            android:excludeFromRecents="false" />

        <!-- 엣지 패널 투명 액티비티 (네비게이션 뒤로가기 100% 보장 및 키보드 adjustResize) -->
        <activity
            android:name=".ui.overlay.EdgePanelActivity"
            android:exported="false"
            android:theme="@style/Theme.NotificationEdge.TranslucentPanel"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="${applicationId}.overlay"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:excludeFromRecents="true" />

        <!-- Good Lock / Shortcut용 엣지 패널 열기 무화면 액티비티 -->
        <activity
            android:name=".ui.OpenPanelActivity"
            android:exported="true"
            android:label="@string/open_panel_activity_label"
            android:theme="@style/Theme.NotificationEdge.TranslucentLauncher"
            android:taskAffinity="${applicationId}.openpanel"
            android:launchMode="standard"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 명시적 브로드캐스트 연동용 리시버. 외부 앱의 직접 호출 지원 여부는 별도 확인한다. -->
        <receiver
            android:name=".service.OpenPanelReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.devdooly.notificationedge.OPEN_PANEL" />
                <action android:name="com.devdooly.notificationedge.CLOSE_PANEL" />
                <action android:name="com.devdooly.notificationedge.TOGGLE_PANEL" />
            </intent-filter>
        </receiver>

        <!-- 동적 앱 바로가기 복원 및 언어 갱신 -->
        <receiver
            android:name=".service.ShortcutRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Notification Listener Service -->
        <service
            android:name=".service.NotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Edge Overlay Floating Service -->
        <service
            android:name=".service.EdgeOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled edge notification handle and edge-lighting overlay while using other apps. The visible foreground notification opens settings and provides a Stop Slivue action. Processing requires explicit in-app consent and notification access." />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.settings.PrivacyPolicyActivity"
            android:exported="false"
            android:theme="@style/Theme.NotificationEdge" />

    </application>

</manifest>
